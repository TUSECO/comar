packagehandler "xbmc" {
    description "XBMC icon cache updater"
    setup {
        command "/usr/bin/gtk-update-icon-cache" "-f" "/usr/share/icons/hicolor"
        match { starts-with "usr/share/icons/hicolor/" }
    }
    post-cleanup {
        command "/usr/bin/gtk-update-icon-cache" "-f" "/usr/share/icons/hicolor"
        match { starts-with "usr/share/icons/hicolor/" }
    }
}
